APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_URL=postgres://postgres@localhost:5432/kamfany_mail
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_FORMAT=pretty
RUST_LOG=info,sqlx=warn
# Install identity. Replace these for another company. The desk reads them from GET /api/v1/brand.
BRAND_NAME="KAMFANY Mail"
BRAND_COMPANY="IT KAMFANY LIMITED"
# Public desk address used in password-reset links. Leave blank to use the first CORS origin.
APP_PUBLIC_URL=
# Optional https logo. Leave blank for the built-in mark.
BRAND_LOGO_URL=https://kore52.com/commons/images/logo.png
# Development only. Ignored unless APP_ENV=development. Creates the owner if missing.
BOOTSTRAP_ADMIN_EMAIL=adaeze@kamfany.com
BOOTSTRAP_ADMIN_NAME="Adaeze Okonkwo"
BOOTSTRAP_ADMIN_PASSWORD=change-this-desk-password
# Leave blank until a new key exists. Do not commit a real key.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_API_BASE=https://api.resend.com
RESEND_SENDING_DOMAIN=kamfany.com
# Local attachment files. Ignored when S3_BUCKET is set.
STORAGE_DIR=storage
# S3-compatible storage. Leave blank until the desk is hosted.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# ClamAV clamd address, for example 127.0.0.1:3310. Leave blank to keep files unscanned.
CLAMAV_ADDRESS=
